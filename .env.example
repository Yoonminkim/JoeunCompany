# 사이트 기준 URL (끝에 / 없이). canonical, sitemap, Open Graph, JSON-LD 의 기준입니다.
# 지정하지 않으면 프로덕션 빌드는 https://joeunill.com, 개발 모드는 http://localhost:3000 을 사용합니다.
# 다른 주소(예: 스테이징)로 빌드할 때만 설정하세요.
# NEXT_PUBLIC_SITE_URL=https://joeunill.com

# 검색엔진 사이트 소유 확인 코드 (각 서치콘솔에서 발급)
# Google Search Console > 소유권 확인 > HTML 태그 의 content 값
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저 > 사이트 소유확인 > HTML 태그 의 content 값
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# 문의 폼 메일 발송 (Resend). RESEND_API_KEY 가 없으면 프로덕션에서 문의 접수가 비활성화됩니다.
# 개발 모드에서는 설정이 없어도 서버 콘솔에 내용이 출력됩니다.
RESEND_API_KEY=
# 문의를 받을 이메일 (선택, 여러 명이면 쉼표로 구분). 비워 두면 대표 이메일(joeunill1@naver.com)로 받습니다.
CONTACT_TO_EMAIL=
# 발신자 (선택). Resend 에서 joeunill.com 도메인을 인증한 뒤 사용하세요.
# 예: 조은상사 홈페이지 <noreply@joeunill.com>
CONTACT_FROM_EMAIL=
