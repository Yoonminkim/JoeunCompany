# 배포 도메인 (끝에 / 없이). canonical, sitemap, Open Graph, JSON-LD 의 기준 URL 입니다.
NEXT_PUBLIC_SITE_URL=https://example.com

# 검색엔진 사이트 소유 확인 코드 (각 서치콘솔에서 발급)
# Google Search Console > 소유권 확인 > HTML 태그 의 content 값
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저 > 사이트 소유확인 > HTML 태그 의 content 값
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# 문의 폼 메일 발송 (Resend). 설정하지 않으면 프로덕션에서 문의 접수가 비활성화됩니다.
# 개발 모드에서는 설정이 없어도 서버 콘솔에 내용이 출력됩니다.
RESEND_API_KEY=
# 문의를 받을 담당자 이메일 (여러 명이면 쉼표로 구분)
CONTACT_TO_EMAIL=
# 발신자 (선택). Resend 에서 인증한 도메인의 주소여야 합니다. 예: 조은상사 홈페이지 <noreply@joeun.co.kr>
CONTACT_FROM_EMAIL=
